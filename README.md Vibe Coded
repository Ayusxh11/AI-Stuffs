              <span>Click <strong className="text-pink-300">background</strong> to deselect</span>
            </li>
          </ul>
        </div>
      )}

      {/* Right Side Info Panel */}
      {selectedRoleData && (
        <div className="absolute top-32 right-12 bottom-12 w-[500px] bg-gray-900/95 backdrop-blur-xl rounded-2xl shadow-2xl border-2 border-purple-500/30 overflow-hidden flex flex-col animate-slide-in">
          <div 
            className="px-8 py-6 border-b border-gray-700/50 relative overflow-hidden"
            style={{ 
              background: `linear-gradient(135deg, ${selectedRoleData.color}30, ${selectedRoleData.color}15)`
            }}
          >
            <div className="absolute inset-0 bg-gradient-to-r from-transparent via-white/5 to-transparent animate-pulse-glow" />
            <div className="flex justify-between items-start mb-4 relative z-10">
              <div className="flex items-center gap-4">
                <div 
                  className="w-16 h-16 rounded-full flex items-center justify-center shadow-xl transition-transform duration-300 hover:scale-110"
                  style={{ backgroundColor: selectedRoleData.color }}
                >
                  {React.createElement(selectedRoleData.icon, { 
                    size: 32, 
                    color: 'white',
                    strokeWidth: 2.5
                  })}
                </div>
                <div>
                  <h2 className="text-3xl font-bold text-white mb-1">
                    {selectedRoleData.name}
                  </h2>
                  <p className="text-gray-400 text-lg font-medium">
                    {selectedRoleData.subtitle}
                  </p>
                </div>
              </div>
              <button
                onClick={(e) => {
                  e.stopPropagation();
                  setSelectedRole(null);
                }}
                className="text-gray-400 hover:text-white transition-all duration-300 bg-gray-800/50 rounded-full p-2 hover:bg-gray-700 hover:rotate-90"
              >
                <X size={24} />
              </button>
            </div>
            
            {/* Metric Display */}
            <div className="flex items-center gap-3 bg-black/30 rounded-lg px-4 py-3 relative z-10">
              <div className="w-10 h-10 rounded-full flex items-center justify-center" style={{ backgroundColor: selectedRoleData.color }}>
                {React.createElement(selectedRoleData.metricIcon, { size: 20, color: 'white' })}
              </div>
              <div>
                <div className="text-2xl font-bold text-white">{selectedRoleData.metric}</div>
                <div className="text-xs text-gray-400">{selectedRoleData.metricLabel}</div>
              </div>
            </div>
          </div>
          
          <div className="flex-1 overflow-y-auto px-8 py-6 space-y-6">
            <div className="hover:bg-gray-800/30 p-4 rounded-lg transition-all duration-300">
              <h3 className="text-sm font-bold text-purple-400 uppercase tracking-wide mb-3 flex items-center gap-2">
                <span className="w-2 h-2 bg-purple-400 rounded-full"></span>
                Main Responsibility
              </h3>
              <p className="text-gray-200 text-lg leading-relaxed">
                {selectedRoleData.description}
              </p>
            </div>
            
            <div className="hover:bg-gray-800/30 p-4 rounded-lg transition-all duration-300">
              <h3 className="text-sm font-bold text-blue-400 uppercase tracking-wide mb-3 flex items-center gap-2">
                <span className="w-2 h-2 bg-blue-400 rounded-full"></span>
                Why This Role Matters
              </h3>
              <p className="text-gray-300 text-base leading-relaxed">
                {selectedRoleData.whyMatters}
              </p>
            </div>
            
            <div className="hover:bg-gray-800/30 p-4 rounded-lg transition-all duration-300">
              <h3 className="text-sm font-bold text-pink-400 uppercase tracking-wide mb-3 flex items-center gap-2">
                <span className="w-2 h-2 bg-pink-400 rounded-full"></span>
                Key Tools & Systems
              </h3>
              <p className="text-gray-300 text-base leading-relaxed">
                {selectedRoleData.keyTools}
              </p>
            </div>
            
            <div className="hover:bg-gray-800/30 p-4 rounded-lg transition-all duration-300">
              <h3 className="text-sm font-bold text-emerald-400 uppercase tracking-wide mb-4 flex items-center gap-2">
                <span className="w-2 h-2 bg-emerald-400 rounded-full"></span>
                Works Closely With
              </h3>
              <div className="flex flex-wrap gap-2">
                {connections.map(connId => {
                  const connRole = roles.find(r => r.id === connId);
                  return (
                    <button
                      key={connId}
                      onClick={(e) => {
                        e.stopPropagation();
                        setSelectedRole(connId);
                      }}
                      className="px-4 py-2 rounded-full text-sm font-semibold transition-all duration-300 hover:scale-110 shadow-lg hover:shadow-xl"
                      style={{ 
                        backgroundColor: connRole?.color,
                        color: 'white'
                      }}
                    >
                      {connRole?.name}
                    </button>
                  );
                })}
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default AmazonFCNetwork;# AI-Stuffs
