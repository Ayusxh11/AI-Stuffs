import React, { useState, useEffect } from 'react';
import { User, Users, Package, Box, Scan, ClipboardCheck, Wrench, AlertCircle, Truck, X, Info, Zap, TrendingUp, Shield, Award, Target, Sparkles } from 'lucide-react';

const AmazonFCNetwork = () => {
  const [selectedRole, setSelectedRole] = useState(null);
  const [hoveredRole, setHoveredRole] = useState(null);
  const [showInstructions, setShowInstructions] = useState(true);
  const [mousePos, setMousePos] = useState({ x: 0, y: 0 });
  const [particles, setParticles] = useState([]);

  useEffect(() => {
    const handleMouseMove = (e) => {
      setMousePos({ x: e.clientX, y: e.clientY });
    };
    window.addEventListener('mousemove', handleMouseMove);
    return () => window.removeEventListener('mousemove', handleMouseMove);
  }, []);

  useEffect(() => {
    const newParticles = Array.from({ length: 50 }, (_, i) => ({
      id: i,
      x: Math.random() * 100,
      y: Math.random() * 100,
      size: Math.random() * 3 + 1,
      speed: Math.random() * 0.5 + 0.2,
      opacity: Math.random() * 0.5 + 0.2
    }));
    setParticles(newParticles);
  }, []);

  const roles = [
    {
      id: 'learning',
      name: 'Learning Ambassador',
      subtitle: 'Training & Onboarding',
      color: '#FF6B6B',
      icon: Users,
      metricIcon: Award,
      metric: '95%',
      metricLabel: 'Training Success',
      x: 960,
      y: 400,
      description: 'Trains and onboards new associates, answers questions, reinforces best practices in safety, quality, and efficiency.',
      keyTools: 'A-to-Z learning system, safety audit checklists, workflow SOPs',
      whyMatters: 'Improves workforce skills, morale, and consistency across shifts. Reduces training time and increases productivity.',
      connections: ['stower', 'picker', 'packer', 'area-mgr']
    },
    {
      id: 'stower',
      name: 'Stower',
      subtitle: 'Inventory Storage',
      color: '#4ECDC4',
      icon: Box,
      metricIcon: Target,
      metric: '98%',
      metricLabel: 'Accuracy Rate',
      x: 580,
      y: 280,
      description: 'Places incoming products into proper storage locations using handheld scanners and Kiva robotic shelves.',
      keyTools: 'RF handheld scanner, Kiva robotic pods, ICQA inventory software',
      whyMatters: 'Ensures inventory accuracy and fast product retrieval. Incorrect stowing affects entire fulfillment chain.',
      connections: ['icqa', 'picker', 'robotics', 'learning']
    },
    {
      id: 'picker',
      name: 'Picker',
      subtitle: 'Order Retrieval',
      color: '#95E1D3',
      icon: Scan,
      metricIcon: TrendingUp,
      metric: '320',
      metricLabel: 'Units Per Hour',
      x: 1340,
      y: 280,
      description: 'Retrieves products from shelves according to customer orders using scanning devices; prepares totes for packing.',
      keyTools: 'RF scanner, Pick-to-Light system, Amazon Picking App',
      whyMatters: 'Directly affects order speed, accuracy, and delivery promise. Performance measured by UPH (units per hour) + accuracy.',
      connections: ['packer', 'stower', 'robotics', 'problem-solver', 'learning']
    },
    {
      id: 'packer',
      name: 'Packer',
      subtitle: 'Final Packaging',
      color: '#FFE66D',
      icon: Package,
      metricIcon: Shield,
      metric: '99.5%',
      metricLabel: 'Quality Score',
      x: 1520,
      y: 480,
      description: 'Packs picked items into correct box sizes, adds protective material, seals, and labels packages for shipment.',
      keyTools: 'Scan-to-Pack app, label printers, box-sizing equipment',
      whyMatters: 'Ensures items reach customers safely and on time. Final QC step before delivery.',
      connections: ['picker', 'problem-solver', 'shipping', 'learning']
    },
    {
      id: 'area-mgr',
      name: 'Area Manager',
      subtitle: 'Operations Leadership',
      color: '#A8E6CF',
      icon: User,
      metricIcon: Sparkles,
      metric: '15+',
      metricLabel: 'Team Members',
      x: 960,
      y: 150,
      description: 'Manages a zone or department, conducts safety checks, assigns labor, reviews performance data, supports associates.',
      keyTools: 'FC KPI dashboard, time-attendance tools, labor planning system',
      whyMatters: 'Aligns daily output with Amazon\'s operational targets and business goals. Drives Kaizen (continuous improvement).',
      connections: ['process-asst', 'learning', 'icqa', 'robotics']
    },
    {
      id: 'robotics',
      name: 'Robotics Tech',
      subtitle: 'System Maintenance',
      color: '#FFB84D',
      icon: Wrench,
      metricIcon: Zap,
      metric: '99.8%',
      metricLabel: 'Uptime',
      x: 680,
      y: 580,
      description: 'Maintains robots, conveyor systems, sensors, and automated storage technology; fixes breakdowns.',
      keyTools: 'Robot command console, maintenance tools, diagnostic software',
      whyMatters: 'Keeps automation running — any stoppage slows fulfillment. Critical role during peak seasons.',
      connections: ['stower', 'picker', 'area-mgr']
    },
    {
      id: 'process-asst',
      name: 'Process Assistant',
      subtitle: 'Team Supervision',
      color: '#C7CEEA',
      icon: ClipboardCheck,
      metricIcon: TrendingUp,
      metric: '110%',
      metricLabel: 'Productivity',
      x: 1200,
      y: 120,
      description: 'Oversees small teams, ensures rate targets are met, resolves workflow issues, reallocates labor based on load.',
      keyTools: 'AFT (Amazon Fulfillment Tool), labor dashboard, shift reports',
      whyMatters: 'Keeps workflow smooth, ensures hourly productivity, safety, and quality. Often promoted internally.',
      connections: ['area-mgr', 'icqa', 'problem-solver']
    },
    {
      id: 'icqa',
      name: 'ICQA',
      subtitle: 'Quality Assurance',
      color: '#B4A7D6',
      icon: ClipboardCheck,
      metricIcon: Shield,
      metric: '99.9%',
      metricLabel: 'Audit Accuracy',
      x: 400,
      y: 400,
      description: 'Performs inventory counts, audits bin accuracy, identifies lost/damaged stock.',
      keyTools: 'ICQA scanner, database tools',
      whyMatters: 'Prevents shrinkage and keeps inventory accurate, impacting customer satisfaction. Critical "health check" team.',
      connections: ['stower', 'picker', 'area-mgr', 'problem-solver']
    },
    {
      id: 'problem-solver',
      name: 'Problem Solver',
      subtitle: 'Issue Resolution',
      color: '#F38181',
      icon: AlertCircle,
      metricIcon: Target,
      metric: '94%',
      metricLabel: 'Resolution Rate',
      x: 1340,
      y: 600,
      description: 'Fixes order issues (missing items, wrong item, damage), assists packers to correct fulfillment errors.',
      keyTools: 'ProblemSolve app, RF scanners',
      whyMatters: 'Protects customer trust by preventing bad orders from shipping. Works heavily during peak when error volume increases.',
      connections: ['packer', 'picker', 'icqa', 'process-asst']
    },
    {
      id: 'shipping',
      name: 'Shipping/Dock',
      subtitle: 'Outbound Dispatch',
      color: '#6C5CE7',
      icon: Truck,
      metricIcon: Zap,
      metric: '2hrs',
      metricLabel: 'Avg Dispatch',
      x: 1650,
      y: 650,
      description: 'Loads packaged orders onto pallets or trucks, verifies manifest and dispatch timing.',
      keyTools: 'Pallet jack, manifest scanner, sorting system',
      whyMatters: 'Ensures outbound shipments leave on-time, key for Prime & 1-day delivery. Very time-sensitive role.',
      connections: ['packer']
    }
  ];

  const getConnections = (roleId) => {
    const role = roles.find(r => r.id === roleId);
    return role ? role.connections : [];
  };

  const activeRole = selectedRole || hoveredRole;
  const connections = activeRole ? getConnections(activeRole) : [];

  const handleBackgroundClick = (e) => {
    if (e.target.tagName === 'svg' || e.target.classList.contains('bg-gradient')) {
      setSelectedRole(null);
    }
  };

  const selectedRoleData = roles.find(r => r.id === selectedRole);
  const hoveredRoleData = roles.find(r => r.id === hoveredRole);

  return (
    <div className="w-full h-screen bg-gradient-to-br from-slate-950 via-purple-950 to-slate-900 flex flex-col overflow-hidden relative" style={{ fontFamily: 'Georgia, serif' }}>
      {/* Animated background particles */}
      <div className="absolute inset-0 overflow-hidden pointer-events-none">
        {particles.map(particle => (
          <div
            key={particle.id}
            className="absolute rounded-full bg-purple-400 animate-float"
            style={{
              left: `${particle.x}%`,
              top: `${particle.y}%`,
              width: `${particle.size}px`,
              height: `${particle.size}px`,
              opacity: particle.opacity,
              animationDuration: `${20 / particle.speed}s`,
              animationDelay: `${particle.id * 0.1}s`
            }}
          />
        ))}
      </div>

      {/* Gradient orbs that follow mouse */}
      <div 
        className="absolute w-96 h-96 rounded-full blur-3xl opacity-20 transition-all duration-1000 pointer-events-none"
        style={{
          background: 'radial-gradient(circle, #8B5CF6 0%, transparent 70%)',
          left: `${mousePos.x - 192}px`,
          top: `${mousePos.y - 192}px`
        }}
      />
      <div 
        className="absolute w-96 h-96 rounded-full blur-3xl opacity-15 transition-all duration-1500 pointer-events-none"
        style={{
          background: 'radial-gradient(circle, #EC4899 0%, transparent 70%)',
          left: `${mousePos.x - 192}px`,
          top: `${mousePos.y - 192}px`
        }}
      />

      <style>{`
        @keyframes float {
          0%, 100% { transform: translateY(0) translateX(0); }
          25% { transform: translateY(-20px) translateX(10px); }
          50% { transform: translateY(-40px) translateX(-10px); }
          75% { transform: translateY(-20px) translateX(5px); }
        }
        .animate-float {
          animation: float linear infinite;
        }
        @keyframes pulse-glow {
          0%, 100% { opacity: 0.4; transform: scale(1); }
          50% { opacity: 1; transform: scale(1.05); }
        }
        .animate-pulse-glow {
          animation: pulse-glow 2s ease-in-out infinite;
        }
        @keyframes slide-in {
          from { opacity: 0; transform: translateX(20px); }
          to { opacity: 1; transform: translateX(0); }
        }
        .animate-slide-in {
          animation: slide-in 0.4s ease-out;
        }
        @keyframes metric-appear {
          from { opacity: 0; transform: scale(0.5); }
          to { opacity: 1; transform: scale(1); }
        }
        .animate-metric-appear {
          animation: metric-appear 0.5s ease-out;
        }
      `}</style>

      <div className="bg-gradient-to-r from-gray-900/90 to-gray-800/90 backdrop-blur-md border-b border-purple-500/20 px-12 py-6 shadow-lg relative z-10">
        <div className="flex justify-between items-center">
          <div>
            <h1 className="text-5xl font-bold text-white mb-2 tracking-tight">Amazon Fulfillment Center Network</h1>
            <p className="text-gray-400 text-xl">Click on any role to see detailed information and highlight connections</p>
          </div>
          <button
            onClick={() => setShowInstructions(!showInstructions)}
            className="flex items-center gap-2 px-6 py-3 bg-purple-600/80 hover:bg-purple-600 text-white rounded-lg transition-all duration-300 hover:scale-105 shadow-lg hover:shadow-purple-500/50"
          >
            <Info size={20} />
            {showInstructions ? 'Hide' : 'Show'} Instructions
          </button>
        </div>
      </div>

      <div className="flex-1 relative" onClick={handleBackgroundClick}>
        <svg className="w-full h-full bg-gradient" viewBox="0 0 1920 1080" preserveAspectRatio="xMidYMid meet">
          <defs>
            <filter id="glow">
              <feGaussianBlur stdDeviation="6" result="coloredBlur"/>
              <feMerge>
                <feMergeNode in="coloredBlur"/>
                <feMergeNode in="SourceGraphic"/>
              </feMerge>
            </filter>
            <linearGradient id="lineGradient" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stopColor="#8B5CF6" stopOpacity="1"/>
              <stop offset="50%" stopColor="#EC4899" stopOpacity="1"/>
              <stop offset="100%" stopColor="#8B5CF6" stopOpacity="1"/>
            </linearGradient>
            <linearGradient id="pulseGradient" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stopColor="#EC4899" stopOpacity="0.8"/>
              <stop offset="100%" stopColor="#8B5CF6" stopOpacity="0.8"/>
            </linearGradient>
          </defs>

          {/* Animated connection lines */}
          {roles.map(role1 => 
            role1.connections.map(conn => {
              const role2 = roles.find(r => r.id === conn);
              if (!role2) return null;
              
              const isActive = activeRole && (
                (role1.id === activeRole && connections.includes(role2.id)) ||
                (role2.id === activeRole && connections.includes(role1.id))
              );
              
              return (
                <g key={`${role1.id}-${conn}`}>
                  <line
                    x1={role1.x}
                    y1={role1.y}
                    x2={role2.x}
                    y2={role2.y}
                    stroke={isActive ? 'url(#lineGradient)' : '#555555'}
                    strokeWidth={isActive ? '5' : '2'}
                    opacity={isActive ? '1' : activeRole ? '0.15' : '0.3'}
                    className="transition-all duration-500"
                    strokeDasharray={isActive ? '0' : '5,5'}
                  />
                  {isActive && (
                    <circle r="5" fill="url(#pulseGradient)" className="animate-pulse-glow">
                      <animateMotion
                        dur="2s"
                        repeatCount="indefinite"
                        path={`M ${role1.x} ${role1.y} L ${role2.x} ${role2.y}`}
                      />
                    </circle>
                  )}
                </g>
              );
            })
          )}

          {/* Role nodes */}
          {roles.map(role => {
            const Icon = role.icon;
            const MetricIcon = role.metricIcon;
            const isActive = activeRole === role.id;
            const isHovered = hoveredRole === role.id;
            const isConnectedToActive = activeRole && connections.includes(role.id);
            const shouldHighlight = !activeRole || isActive || isConnectedToActive;
            const scale = isActive ? 1.3 : isHovered ? 1.15 : 1;
            
            return (
              <g
                key={role.id}
                transform={`translate(${role.x}, ${role.y})`}
                onMouseEnter={() => setHoveredRole(role.id)}
                onMouseLeave={() => setHoveredRole(null)}
                onClick={(e) => {
                  e.stopPropagation();
                  setSelectedRole(selectedRole === role.id ? null : role.id);
                }}
                className="cursor-pointer transition-all duration-500"
                style={{ opacity: shouldHighlight ? 1 : 0.25 }}
              >
                {/* Multiple glow rings for active state */}
                {isActive && (
                  <>
                    <circle r="110" fill="none" stroke={role.color} strokeWidth="2" opacity="0.2" className="animate-pulse-glow" />
                    <circle r="95" fill="none" stroke={role.color} strokeWidth="3" opacity="0.4" className="animate-pulse" style={{ animationDuration: '1.5s' }} />
                  </>
                )}
                
                {/* Hover ring */}
                {isHovered && !isActive && (
                  <circle r="85" fill="none" stroke={role.color} strokeWidth="2" opacity="0.5" className="transition-all duration-300" />
                )}
                
                {/* Main circle with gradient */}
                <circle
                  r={65 * scale}
                  fill={`url(#grad-${role.id})`}
                  className="transition-all duration-500"
                  filter={isActive || isHovered ? 'url(#glow)' : undefined}
                  style={{
                    filter: isActive ? `drop-shadow(0 0 30px ${role.color})` : isHovered ? `drop-shadow(0 0 20px ${role.color}80)` : 'drop-shadow(0 6px 15px rgba(0,0,0,0.5))'
                  }}
                />
                
                <defs>
                  <radialGradient id={`grad-${role.id}`}>
                    <stop offset="0%" stopColor={role.color} stopOpacity="1" />
                    <stop offset="100%" stopColor={role.color} stopOpacity="0.8" />
                  </radialGradient>
                </defs>
                
                {/* White border */}
                <circle
                  r={65 * scale}
                  fill="none"
                  stroke="white"
                  strokeWidth={isActive ? "5" : "3"}
                  className="transition-all duration-500"
                  opacity="0.9"
                />
                
                {/* Icon */}
                <foreignObject
                  x={-28 * scale}
                  y={-28 * scale}
                  width={56 * scale}
                  height={56 * scale}
                  className="pointer-events-none"
                >
                  <div className="flex items-center justify-center h-full">
                    <Icon size={38 * scale} color="white" strokeWidth={2.5} className="transition-all duration-300" />
                  </div>
                </foreignObject>
                
                {/* Metric badge on hover */}
                {isHovered && (
                  <g className="animate-metric-appear">
                    <circle cx="50" cy="-50" r="35" fill={role.color} opacity="0.95" filter="url(#glow)" />
                    <circle cx="50" cy="-50" r="35" fill="none" stroke="white" strokeWidth="2" opacity="0.8" />
                    <foreignObject x="15" y="-85" width="70" height="70" className="pointer-events-none">
                      <div className="flex flex-col items-center justify-center h-full">
                        <MetricIcon size={20} color="white" strokeWidth={2.5} />
                        <text className="text-white text-xs font-bold" style={{ fontSize: '11px' }}>{role.metric}</text>
                      </div>
                    </foreignObject>
                    <text x="50" y="-20" textAnchor="middle" fill="white" fontSize="10" fontWeight="600" opacity="0.9">
                      {role.metricLabel}
                    </text>
                  </g>
                )}
                
                {/* Role name */}
                <text
                  y={95}
                  textAnchor="middle"
                  fill="white"
                  fontSize={isActive ? "24" : "20"}
                  fontWeight="700"
                  className="transition-all duration-500 pointer-events-none"
                  style={{ textShadow: '0 3px 8px rgba(0,0,0,0.8)' }}
                >
                  {role.name}
                </text>
                
                {/* Subtitle */}
                <text
                  y={118}
                  textAnchor="middle"
                  fill="#D1D5DB"
                  fontSize="16"
                  fontWeight="400"
                  className="pointer-events-none transition-all duration-500"
                  opacity="0.95"
                >
                  {role.subtitle}
                </text>
              </g>
            );
          })}
        </svg>
      </div>

      {/* Instructions Panel */}
      {showInstructions && (
        <div className="absolute top-32 right-12 bg-gray-900/95 backdrop-blur-xl rounded-2xl px-7 py-6 shadow-2xl border-2 border-purple-500/30 max-w-sm animate-slide-in">
          <div className="flex justify-between items-start mb-4">
            <h3 className="text-white font-bold text-xl flex items-center gap-3">
              <span className="w-3 h-3 bg-purple-500 rounded-full animate-pulse"></span>
              Instructions
            </h3>
            <button
              onClick={() => setShowInstructions(false)}
              className="text-gray-400 hover:text-white transition-colors hover:rotate-90 duration-300"
            >
              <X size={20} />
            </button>
          </div>
          <ul className="text-gray-300 text-base space-y-3 leading-relaxed">
            <li className="flex items-start gap-3 hover:text-purple-300 transition-colors duration-200">
              <span className="text-purple-400 font-bold text-lg">•</span>
              <span><strong className="text-purple-300">Click</strong> on any role to see detailed information</span>
            </li>
            <li className="flex items-start gap-3 hover:text-blue-300 transition-colors duration-200">
              <span className="text-blue-400 font-bold text-lg">•</span>
              <span><strong className="text-blue-300">Hover</strong> to see metrics and preview connections</span>
            </li>
            <li className="flex items-start gap-3 hover:text-pink-300 transition-colors duration-200">
